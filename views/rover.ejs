<%- include("partials/header.ejs") %>

    <% if (locals.rover) { %> 
    <main>
        <div class="bg-white">
            <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">

                <div class="lg:text-center">
                    <hr>
                    <h2 class="my-8 text-2xl font-bold"><%= rover.fullName %></h2>
                </div>

                <form class="mb-6" action="/rovers/<%= rover.shortName %>/photos" method="post">
                    <input type="hidden" name="roverName" value="<%= rover.fullname %>" />
                    <div class="space-y-12">
                        <div class="border-b border-gray-900/10 pb-12">
                            <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-2 md:gap-y-8 sm:grid-cols-6">
                                <div class="sm:col-span-1">
                                    <label for="rover" class="block text-sm font-medium leading-6 text-gray-900">Rover</label>
                                    <div class="mt-0 md:mt-1">
                                        <select id="rover-select" name="rover"
                                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                            <% if (locals.roversArr) { %>
                                                <% roversArr.forEach(r => { %>
                                                    <% if (rover.shortName === r) { %>
                                                        <option value="<%= r %>" selected><%= rover.fullName %></option>
                                                    <% } else { %>
                                                        <option value="<%= r %>"><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
                                                    <% } %>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                </div>
                                <div class="sm:col-span-2">
                                    <label for="earth-date" class="block text-sm font-medium leading-6 text-gray-900">Earth Date</label>
                                    <div class="mt-0 md:mt-1">
                                        <% if (locals.selectedDate) { %>
                                        <input type="date" name="earthDate" id="earth-date"
                                            value="<%= selectedDate %>"
                                            min="<%= rover.landing %>" max="<%= rover.maxDate %>"
                                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                        <% } else { %>
                                        <input type="date" name="earthDate" id="earth-date"
                                            value="<%= rover.maxDate %>"
                                            min="<%= rover.landing %>" max="<%= rover.maxDate %>"
                                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                        <% } %>
                                    </div>
                                </div>
                                <div class="sm:col-span-2">
                                    <label for="camera" class="block text-sm font-medium leading-6 text-gray-900">Camera</label>
                                    <div class="mt-0 md:mt-1">
                                        <select id="camera" name="camera"
                                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                            <% if (locals.selectedCamera && selectedCamera === null) { %>
                                                <option value="" selected>All</option>
                                            <% } else { %>
                                                <option value="">All</option>
                                            <% } %>
                                            <% if (locals.cameras) { %>
                                                <% cameras.forEach(cam => { %>
                                                    <% if (locals.selectedCamera && selectedCamera === cam.name) { %>
                                                        <option value="<%= cam.name %>" selected><%= cam.full_name %></option>
                                                    <% } else { %>
                                                        <option value="<%= cam.name %>"><%= cam.full_name %></option>
                                                    <% } %>
                                                <% }); %>
                                            <% } %>
                                        </select>
                                    </div>
                                </div>
                                <div class="sm:col-span-1">
                                    <label for="" class="block text-sm font-medium leading-6 text-gray-900">&nbsp;</label>
                                    <div class="mt-0 md:mt-1">
                                        <button type="submit"
                                            class="w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">View Photos</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <% if (locals.photos && locals.photos.length > 0) { %>
                <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 xl:gap-x-8">
                    <% photos.forEach(photo => { %>
                    <a href="<%= photo.img_src %>" class="group" target="_blank">
                        <div
                            class="aspect-h-1 aspect-w-1 w-full overflow-hidden rounded-lg bg-gray-200 xl:aspect-h-8 xl:aspect-w-7">
                            <img src="<%= photo.img_src %>"
                                alt="Tall slender porcelain bottle with natural clay textured body and cork stopper."
                                class="h-full w-full object-cover object-center group-hover:opacity-75">
                        </div>
                        <p class="mt-2 text-sm text-gray-600"><%= photo.camera.full_name %></p>
                    </a>
                    <% }); %>
                </div>
                <% } else { %>
                    <p>No photos available for this date.</p>
                <% } %>
            </div>
        </div>
    </main>
    <% } else if (locals.error) { %>
        <main class="grid min-h-full place-items-center bg-white px-6 py-6 sm:py-8 lg:px-8">
            <div class="text-center">
                <p class="text-base font-semibold text-indigo-600"><%= error.status %></p>
                <h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance text-gray-900 sm:text-7xl"><%= error.name %></h1>
                <p class="mt-6 text-lg font-medium text-pretty text-gray-500 sm:text-xl/8"><%= error.message %></p>
                <div class="mt-10 flex items-center justify-center gap-x-6">
                    <form method="post" action="<%= tryAgainUrl %>">
                        <button type="submit" class="rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-2xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Try Again</button>
                    </form>
                    <!-- <a href="#" class="text-sm font-semibold text-gray-900">Contact support <span aria-hidden="true">&rarr;</span></a> -->
                </div>
            </div>
        </main>
    <% } %>

   
    
<%- include("partials/footer.ejs") %>